---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/dm-sans";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "../styles/global.css";
import { NAV_ITEMS, STUDIO, buildOrganizationSchema, buildWebSiteSchema } from "../data/site";

export interface BreadcrumbItem {
  name: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
  preloadHeroBase?: string;
  ogType?: "website" | "article";
  breadcrumbs?: BreadcrumbItem[];
  schemas?: Record<string, unknown>[];
}

const {
  title,
  description,
  ogImage = "/images/og-flexarion.jpg",
  ogImageAlt = "Flexarion, studio de jeux vidéo de science-fiction à Aix-en-Provence",
  noindex = false,
  preloadHeroBase,
  ogType = "website",
  breadcrumbs = [],
  schemas = [],
} = Astro.props;

const siteOrigin = Astro.site ? Astro.site.origin : "https://flexarion.alwaysdata.net";
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;
const absoluteOgImage = new URL(ogImage, siteOrigin).href;
const currentPath = Astro.url.pathname;
// Lien actif : la correspondance la plus longue gagne (évite Veridia 2140 + Univers actifs en même temps).
const activeHref = NAV_ITEMS.map((item) => item.href)
  .filter((href) => (href === "/" ? currentPath === "/" : currentPath.startsWith(href)))
  .sort((a, b) => b.length - a.length)[0];

const breadcrumbSchema =
  breadcrumbs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: breadcrumbs.map((item, idx) => ({
          "@type": "ListItem",
          position: idx + 1,
          name: item.name,
          item: new URL(item.href, siteOrigin).href,
        })),
      }
    : null;

const allSchemas = [
  buildOrganizationSchema(siteOrigin),
  ...(currentPath === "/" ? [buildWebSiteSchema(siteOrigin)] : []),
  ...(breadcrumbSchema ? [breadcrumbSchema] : []),
  ...schemas,
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"}
    />
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    <meta name="application-name" content={STUDIO.name} />
    <meta name="theme-color" content="#13262E" />
    <meta name="geo.region" content="FR-13" />
    <meta name="geo.placename" content="Aix-en-Provence" />
    <link rel="icon" href="/icon-48.png" sizes="48x48" type="image/png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {
      preloadHeroBase && (
        <link
          rel="preload"
          as="image"
          type="image/webp"
          imagesrcset={`${preloadHeroBase}-640.webp 640w, ${preloadHeroBase}.webp 1280w`}
          imagesizes="(max-width: 920px) 100vw, 560px"
          fetchpriority="high"
        />
      )
    }

    <!-- Open Graph -->
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={STUDIO.legalName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content={ogImage.includes("og-flexarion") ? "1200" : "1280"} />
    <meta property="og:image:height" content={ogImage.includes("og-flexarion") ? "630" : "720"} />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={STUDIO.xHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Données structurées JSON-LD (SEO & GEO) -->
    {
      allSchemas.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
  </head>
  <body>
    <a class="sr-only" href="#contenu">Aller au contenu</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href="/" class="brand" aria-label="Flexarion, retour à l'accueil">
          <img src="/favicon.svg" alt="Logo Flexarion" width="40" height="40" />
          Flexarion
        </a>
        <nav class="nav-scroll" aria-label="Navigation principale">
          <ul class="nav">
            {
              NAV_ITEMS.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.href === activeHref ? "page" : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="contenu">
      {
        breadcrumbs.length > 0 && (
          <nav class="wrap breadcrumbs" aria-label="Fil d'Ariane">
            {breadcrumbs.map((crumb, index) => (
              <>
                {index > 0 && <span aria-hidden="true">/</span>}
                {index === breadcrumbs.length - 1 ? (
                  <span aria-current="page">{crumb.name}</span>
                ) : (
                  <a href={crumb.href}>{crumb.name}</a>
                )}
              </>
            ))}
          </nav>
        )
      }
      <slot />
    </main>

    <footer class="site-footer">
      <svg class="footer-ridge" viewBox="0 0 1600 60" preserveAspectRatio="none" aria-hidden="true">
        <path
          d="M0 60 L0 44 L180 40 L320 30 L420 34 L560 12 L610 4 L640 10 L690 8 L860 26 L1040 34 L1250 42 L1600 46 L1600 60 Z"
          fill="#13262E"
        />
      </svg>
      <div class="wrap footer-grid">
        <div>
          <h2>Flexarion, Aix-en-Provence</h2>
          <p>
            Studio indépendant de jeux vidéo de science-fiction. Nous développons
            <strong>Veridia 2140</strong>, un city-builder où toute l'eau de la ville descend par gravité.
          </p>
        </div>
        <div>
          <h2>Le site</h2>
          <ul>
            <li><a href="/">Accueil</a></li>
            <li><a href="/studio/">Le studio</a></li>
            <li><a href="/jeux/veridia-2140/">Veridia 2140</a></li>
            <li><a href="/jeux/veridia-2140/univers/">L'univers du jeu</a></li>
            <li><a href="/devlogs/">Devlogs</a></li>
            <li><a href="/contact/">Contact et presse</a></li>
          </ul>
        </div>
        <div>
          <h2>Ailleurs</h2>
          <ul>
            <li>
              <a href={STUDIO.instagramMain} target="_blank" rel="noopener noreferrer">
                Instagram {STUDIO.instagramHandle}
              </a>
            </li>
            <li>
              <a href={STUDIO.youtube} target="_blank" rel="noopener noreferrer">YouTube</a>
            </li>
            <li>
              <a href={STUDIO.x} target="_blank" rel="noopener noreferrer">X {STUDIO.xHandle}</a>
            </li>
            <li>
              <a href={STUDIO.tiktok} target="_blank" rel="noopener noreferrer">TikTok @flexarion_studio</a>
            </li>
            <li>
              <a href={STUDIO.itch} target="_blank" rel="noopener noreferrer">itch.io</a>
            </li>
            <li>
              <a href={STUDIO.githubRepo} target="_blank" rel="noopener noreferrer">Code source sur GitHub</a>
            </li>
            <li><a href="/llms.txt">llms.txt</a></li>
          </ul>
        </div>
      </div>
      <div class="wrap footer-bottom">
        <span>© 2026 Flexarion. Studio fictif créé en BUT Informatique à l'IUT d'Aix-Marseille.</span>
        <span>Aucun jeu n'est vendu sur ce site.</span>
      </div>
    </footer>
  </body>
</html>
