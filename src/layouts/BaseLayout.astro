---
import "@fontsource-variable/fraunces";
import "@fontsource-variable/dm-sans";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "@fontsource/ibm-plex-mono/latin-600.css";
import "../styles/global.css";
import { NAV_ITEMS, STUDIO, buildOrganizationSchema, buildWebSiteSchema } from "../data/site";

export interface BreadcrumbItem {
  name: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
  preloadHeroBase?: string;
  ogType?: "website" | "article";
  breadcrumbs?: BreadcrumbItem[];
  schemas?: Record<string, unknown>[];
}

const {
  title,
  description,
  ogImage = "/images/og-flexarion.jpg",
  ogImageAlt = "Flexarion, studio de jeux vidéo de science-fiction à Aix-en-Provence",
  noindex = false,
  preloadHeroBase,
  ogType = "website",
  breadcrumbs = [],
  schemas = [],
} = Astro.props;

const siteOrigin = Astro.site ? Astro.site.origin : "https://flexarion.alwaysdata.net";
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;
const absoluteOgImage = new URL(ogImage, siteOrigin).href;
const currentPath = Astro.url.pathname;
// Lien actif : la correspondance la plus longue gagne (évite Veridia 2140 + Univers actifs en même temps).
const activeHref = NAV_ITEMS.map((item) => item.href)
  .filter((href) => (href === "/" ? currentPath === "/" : currentPath.startsWith(href)))
  .sort((a, b) => b.length - a.length)[0];

const breadcrumbSchema =
  breadcrumbs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: breadcrumbs.map((item, idx) => ({
          "@type": "ListItem",
          position: idx + 1,
          name: item.name,
          item: new URL(item.href, siteOrigin).href,
        })),
      }
    : null;

const allSchemas = [
  buildOrganizationSchema(siteOrigin),
  ...(currentPath === "/" ? [buildWebSiteSchema(siteOrigin)] : []),
  ...(breadcrumbSchema ? [breadcrumbSchema] : []),
  ...schemas,
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"}
    />
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    <meta name="application-name" content={STUDIO.name} />
    <meta name="theme-color" content="#F5F0E6" />
    <meta name="geo.region" content="FR-13" />
    <meta name="geo.placename" content="Aix-en-Provence" />
    <link rel="icon" href="/icon-48.png" sizes="48x48" type="image/png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {
      preloadHeroBase && (
        <link
          rel="preload"
          as="image"
          type="image/webp"
          imagesrcset={`${preloadHeroBase}-640.webp 640w, ${preloadHeroBase}.webp 1280w`}
          imagesizes="(max-width: 920px) 100vw, 560px"
          fetchpriority="high"
        />
      )
    }

    <!-- Open Graph -->
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={STUDIO.legalName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content={ogImage.includes("og-flexarion") ? "1200" : "1280"} />
    <meta property="og:image:height" content={ogImage.includes("og-flexarion") ? "630" : "720"} />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Données structurées JSON-LD (SEO & GEO) -->
    {
      allSchemas.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
  </head>
  <body>
    <div class="masthead-bar">
      <div class="container masthead-inner">
        <span>43.5297° N, 5.4474° E · Aix-en-Provence</span>
        <span>Flexarion Studio · Projet BUT Informatique (AMU)</span>
      </div>
    </div>

    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand-link" aria-label="Accueil Flexarion Studio">
          <img
            src="/images/flexarion-logo.svg"
            alt="Logo Flexarion Studio Aix-en-Provence"
            width="210"
            height="45"
          />
        </a>

        <nav aria-label="Navigation principale">
          <ul class="nav-links">
            {
              NAV_ITEMS.map((item) => {
                const isActive = item.href === activeHref;
                return (
                  <li>
                    <a
                      href={item.href}
                      aria-current={isActive ? "page" : undefined}
                      class={item.isCta ? "nav-cta" : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>
      </div>
    </header>

    <main>
      {
        breadcrumbs.length > 0 && (
          <div class="container" style="padding-top: 1.5rem;">
            <nav class="breadcrumbs" aria-label="Fil d'Ariane">
              {breadcrumbs.map((crumb, index) => (
                <>
                  {index > 0 && <span aria-hidden="true">/</span>}
                  {index === breadcrumbs.length - 1 ? (
                    <span aria-current="page">{crumb.name}</span>
                  ) : (
                    <a href={crumb.href}>{crumb.name}</a>
                  )}
                </>
              ))}
            </nav>
          </div>
        )
      }
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <p class="footer-title">Flexarion Studio, Aix-en-Provence</p>
            <p>
              Collectif indépendant dédié à une science-fiction Solarpunk méditerranéenne et à la
              modélisation systémique. Créateurs du concept <strong>Veridia 2140</strong>.
            </p>
          </div>

          <div>
            <p class="footer-title">Sommaire du site</p>
            <ul class="footer-list">
              <li><a href="/">Accueil Flexarion</a></li>
              <li><a href="/studio/">Le Studio à Aix-en-Provence</a></li>
              <li><a href="/jeux/veridia-2140/">Dossier Veridia 2140</a></li>
              <li><a href="/jeux/veridia-2140/univers/">Univers et lore de Veridia 2140</a></li>
              <li><a href="/devlogs/">Carnets de développement</a></li>
              <li><a href="/contact/">Contact &amp; Dossier Presse</a></li>
            </ul>
          </div>

          <div>
            <p class="footer-title">Réseaux &amp; Documentation</p>
            <ul class="footer-list">
              <li>
                <a href={STUDIO.instagramMain} target="_blank" rel="noopener noreferrer">
                  Instagram ({STUDIO.instagramHandle})
                </a>
              </li>
              <li>
                <a href={STUDIO.githubRepo} target="_blank" rel="noopener noreferrer">
                  Dépôt technique GitHub
                </a>
              </li>
              <li><a href="/llms.txt">Index GEO (/llms.txt)</a></li>
            </ul>
          </div>
        </div>

        <div class="footer-bottom">
          <span>© 2026 Flexarion Studio (Concept fictif réalisé en BUT Informatique, IUT d'Aix-Marseille).</span>
          <span>Aucune vente réelle · Transparence IA &amp; SEO White Hat</span>
        </div>
      </div>
    </footer>
  </body>
</html>
