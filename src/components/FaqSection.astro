---
export interface FaqEntry {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  subtitle?: string;
  items: FaqEntry[];
  emitSchema?: boolean;
  tone?: "limestone" | "chalk";
}

const { title, subtitle, items, emitSchema = true, tone = "limestone" } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<section class:list={["block", tone === "chalk" && "block-chalk"]} aria-labelledby="faq-heading">
  <div class="wrap narrow">
    <h2 id="faq-heading">{title}</h2>
    {subtitle && <p>{subtitle}</p>}
    <div class="faq">
      {
        items.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
  {emitSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
</section>
