---
export interface FaqEntry {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  subtitle?: string;
  items: FaqEntry[];
  emitSchema?: boolean;
}

const { title, subtitle, items, emitSchema = true } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<section class="section-tight section-ruled" aria-labelledby="faq-heading">
  <div class="container">
    <span class="kicker kicker-pine">Questions fréquentes</span>
    <h2 id="faq-heading">{title}</h2>
    {subtitle && <p class="lead">{subtitle}</p>}

    <div class="faq-list">
      {
        items.map((item, idx) => (
          <details class="faq-item" open={idx === 0}>
            <summary>
              <span>
                <span style="font-family: var(--font-mono); font-size: 0.85rem; color: var(--ochre); margin-right: 0.65rem;">
                  0{idx + 1}
                </span>
                {item.question}
              </span>
            </summary>
            <div class="faq-answer">
              <p style="margin: 0;">{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>

  {emitSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
</section>
