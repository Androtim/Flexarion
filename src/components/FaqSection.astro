---
export interface FaqEntry {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  subtitle?: string;
  items: FaqEntry[];
  emitSchema?: boolean;
}

const { title, subtitle, items, emitSchema = true } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<section class="section-tight" aria-labelledby="faq-heading">
  <div class="container">
    <span class="eyebrow badge-emerald">Questions fréquentes · GEO</span>
    <h2 id="faq-heading">{title}</h2>
    {subtitle && <p class="lead">{subtitle}</p>}

    <div class="faq-list" style="margin-top: 1.5rem;">
      {
        items.map((item, idx) => (
          <details class="faq-item" open={idx === 0}>
            <summary>{item.question}</summary>
            <div class="faq-answer">
              <p style="margin: 0;">{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>

  {emitSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
</section>
