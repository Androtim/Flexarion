---
// Vidéo YouTube « légère » : notre propre image d'aperçu, et YouTube (domaine sans cookie)
// ne se charge qu'au clic. Émet les données structurées VideoObject pour Google.
import ResponsivePicture from "./ResponsivePicture.astro";

interface Props {
  id: string;
  title: string;
  description: string;
  poster: string;
  uploadDate: string;
  duration: string; // ISO 8601, ex. PT30S
}
const { id, title, description, poster, uploadDate, duration } = Astro.props;
const siteOrigin = Astro.site ? Astro.site.origin : "https://flexarion.alwaysdata.net";

const schema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  name: title,
  description,
  thumbnailUrl: [new URL(poster, siteOrigin).href, `https://i.ytimg.com/vi/${id}/maxresdefault.jpg`],
  uploadDate,
  duration,
  embedUrl: `https://www.youtube-nocookie.com/embed/${id}`,
  contentUrl: `https://www.youtube.com/watch?v=${id}`,
  publisher: { "@id": `${siteOrigin}/#organization` },
};
---

<div class="yt" data-yt={id}>
  <button type="button" class="yt-play" aria-label={`Lire la vidéo : ${title}`}>
    <ResponsivePicture src={poster} alt={title} width={1280} height={720} sizes="(max-width: 920px) 100vw, 860px" />
    <span class="yt-icon" aria-hidden="true">
      <svg viewBox="0 0 68 48"><path d="M66.5 7.7a8.5 8.5 0 0 0-6-6C55.2.3 34 .3 34 .3s-21.2 0-26.5 1.4a8.5 8.5 0 0 0-6 6C.1 13 .1 24 .1 24s0 11 1.4 16.3a8.5 8.5 0 0 0 6 6C12.8 47.7 34 47.7 34 47.7s21.2 0 26.5-1.4a8.5 8.5 0 0 0 6-6C67.9 35 67.9 24 67.9 24s0-11-1.4-16.3z" fill="#F0A43A"/><path d="M27 34.3 45 24 27 13.7z" fill="#13262E"/></svg>
    </span>
  </button>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</div>
<p class="yt-note">La vidéo n'est chargée depuis YouTube qu'au clic. <a href="/mentions-legales/#donnees">En savoir plus</a></p>

<script>
  document.querySelectorAll<HTMLElement>("[data-yt]").forEach((box) => {
    box.querySelector("button")?.addEventListener("click", () => {
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${box.dataset.yt}?autoplay=1&rel=0`;
      iframe.title = box.querySelector("button")?.getAttribute("aria-label") ?? "Vidéo";
      iframe.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
      iframe.allowFullscreen = true;
      box.replaceChildren(iframe);
    });
  });
</script>

<style>
  .yt-note {
    margin: 0.6rem 0 0;
    font-size: 0.82rem;
    opacity: 0.75;
  }

  .yt-note a {
    color: inherit;
  }

  .yt {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-l);
    overflow: hidden;
    background: var(--dusk);
  }

  .yt-play {
    all: unset;
    display: block;
    width: 100%;
    height: 100%;
    cursor: pointer;
    position: relative;
  }

  .yt-play :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .yt-play:hover :global(img) {
    transform: scale(1.02);
  }

  .yt-play:focus-visible {
    outline: 3px solid var(--sun);
    outline-offset: -3px;
  }

  .yt-icon {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }

  .yt-icon svg {
    width: 76px;
    height: 54px;
    filter: drop-shadow(0 6px 16px rgba(0, 0, 0, 0.45));
  }

  .yt :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
