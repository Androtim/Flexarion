---
import { REWIRE_VERSION, TECH_UPGRADES, TOOLS } from "../rewire/content";
---

<div class="rewire-app" data-rewire-root>
  <div class="rw-top-bar">
    <button type="button" class="rw-clicker" data-generate>
      <span class="rw-clicker-title">⚡ Dynamo d'urgence</span>
      <span class="rw-clicker-gain" data-click-gain>+2 cr. · +6 MW</span>
      <span class="rw-heat-track" aria-hidden="true"><span class="rw-heat-fill" data-heat-fill></span></span>
    </button>
    <div class="rw-hud" aria-label="Tableau de bord du réseau électrique">
      <div class="rw-stat">
        <span class="rw-k">Livré / Demande</span>
        <strong data-prod>0 / 0 MW</strong>
      </div>
      <div class="rw-stat">
        <span class="rw-k">Stockage</span>
        <strong data-storage>0 / 0 MWh</strong>
      </div>
      <div class="rw-stat">
        <span class="rw-k">Vert · Renaturation</span>
        <strong><span data-green>0 %</span> · <span data-renature>0 %</span></strong>
      </div>
      <div class="rw-stat">
        <span class="rw-k">Fréquence · Heure</span>
        <strong><span data-freq>50.0 Hz</span> · <span data-clock>07:00</span></strong>
      </div>
      <div class="rw-stat">
        <span class="rw-k">Crédits</span>
        <strong data-credits>40 cr. (+0.0/s)</strong>
      </div>
      <div class="rw-stat">
        <span class="rw-k">Carte · Quartiers</span>
        <strong><span data-zone>Zone 1/5 (7×7)</span> · <span data-cities>1/2 · 1 foss.</span></strong>
      </div>
    </div>
  </div>

  <div class="rw-expand-bar">
    <button type="button" class="rw-expand-btn" data-expand disabled>
      🔒 Extension : Reconvertissez encore 1 centrale(s)
    </button>
  </div>

  <div class="rw-event" data-event-banner hidden role="alert"></div>

  <div class="rw-layout">
    <div class="rw-stage">
      <div class="rw-canvas-wrap">
        <canvas data-canvas aria-label="Carte évolutive du réseau électrique REWIRE"></canvas>
        <div class="rw-overlay" data-end-overlay hidden>
          <div class="rw-modal">
            <h2 data-end-title>Blackout généralisé</h2>
            <p data-end-desc></p>
            <div class="rw-modal-actions">
              <button type="button" class="btn btn-sun" data-retry>Réessayer cette carte</button>
              <button type="button" class="btn btn-ghost" data-new-map>Nouvelle carte procédurale</button>
            </div>
          </div>
        </div>
      </div>
      <p class="rw-msg" data-msg role="status" aria-live="polite">
        Zone 1 (7×7) : reliez le 2e quartier, préparez le pic du soir (19 h) et reconvertissez la centrale pour étendre la carte !
      </p>

      <div class="rw-upgrades-box">
        <h3>Améliorations (Tech Tree)</h3>
        <div class="rw-upgrades-grid">
          {
            TECH_UPGRADES.map((u) => (
              <button type="button" class="rw-upg" data-upgrade={u.id}>
                <span class="rw-upg-top">
                  <strong>{u.name}</strong>
                  <span class="rw-upg-badge">
                    <span data-upg-lvl={u.id}>0/{u.maxLevel}</span> · <strong data-upg-cost={u.id}>{u.baseCost} cr.</strong>
                  </span>
                </span>
                <small>{u.help}</small>
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <aside class="rw-panel" aria-label="Outils et modificateurs">
      <div class="rw-box">
        <h3>Outils (prix croissant)</h3>
        <div class="rw-tools">
          {
            TOOLS.map((t) => (
              <button type="button" class="rw-tool" data-tool={t.id} title={t.help}>
                <span class="rw-tool-top">
                  <strong>{t.name}</strong>
                  <span data-tool-cost={t.id}>{t.baseCost > 0 ? `${t.baseCost} cr.` : "50 %"}</span>
                </span>
                <small>{t.help}</small>
              </button>
            ))
          }
        </div>
      </div>

      <div class="rw-box">
        <h3>Modificateurs (Vote Épisode 1)</h3>
        <label class="rw-check">
          <input type="checkbox" data-mod-gravity checked />
          <span><strong>Option A :</strong> Stockage gravitaire (centrale reconvertie = 120 MWh)</span>
        </label>
        <label class="rw-check">
          <input type="checkbox" data-mod-flywheels />
          <span><strong>Option B :</strong> Volants d'inertie (absorbe les pics et stabilise 50 Hz)</span>
        </label>
      </div>

      <div class="rw-box rw-controls">
        <button type="button" class="rw-btn" data-pause>Pause</button>
        <button type="button" class="rw-btn" data-speed>×2</button>
        <button type="button" class="rw-btn" data-new-map>Nouvelle carte</button>
      </div>

      <p class="rw-meta">
        REWIRE v{REWIRE_VERSION} · Meilleure extension : Zone <strong data-best-zone>1/5</strong>
      </p>
    </aside>
  </div>
</div>

<script>
  import { bootRewire } from "../rewire/main";
  document.querySelectorAll<HTMLElement>("[data-rewire-root]").forEach(bootRewire);
</script>

<style>
  .rewire-app {
    background: #13262e;
    color: var(--limestone);
    border-radius: 18px;
    padding: 1.15rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  .rw-top-bar {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 0.75rem;
    margin-bottom: 0.7rem;
    align-items: stretch;
  }
  .rw-clicker {
    background: linear-gradient(135deg, #f0a43a, #e27d29);
    color: #13262e;
    border: none;
    border-radius: 12px;
    padding: 0.65rem 0.85rem;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.25rem;
    font: inherit;
    box-shadow: 0 4px 14px rgba(240, 164, 58, 0.28);
    transition: transform 0.08s ease;
  }
  .rw-clicker:disabled {
    background: #4f3a34;
    color: #ffb4a2;
    box-shadow: none;
    cursor: not-allowed;
  }
  .rw-clicker:active,
  .rw-clicker.rw-pop {
    transform: scale(0.96);
  }
  .rw-clicker-title {
    font-weight: 800;
    font-size: 0.96rem;
  }
  .rw-clicker-gain {
    font-size: 0.8rem;
    font-weight: 700;
    opacity: 0.9;
  }
  .rw-heat-track {
    width: 100%;
    height: 6px;
    border-radius: 99px;
    background: rgba(19, 38, 46, 0.35);
    overflow: hidden;
    margin-top: 0.15rem;
  }
  .rw-heat-fill {
    display: block;
    height: 100%;
    width: 0%;
    background: #c43721;
    transition: width 0.1s linear;
  }
  .rw-hud {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 0.5rem;
  }
  .rw-stat {
    background: rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 0.48rem 0.7rem;
  }
  .rw-k {
    display: block;
    font-size: 0.72rem;
    color: var(--soft);
  }
  .rw-stat strong {
    font-size: 0.9rem;
    color: #fff;
  }
  .rw-expand-bar {
    margin-bottom: 0.75rem;
  }
  .rw-expand-btn {
    width: 100%;
    padding: 0.65rem 1rem;
    border-radius: 10px;
    border: 1.5px solid #2ad4a5;
    background: rgba(42, 212, 165, 0.18);
    color: #fff;
    font: inherit;
    font-weight: 700;
    font-size: 0.92rem;
    cursor: pointer;
  }
  .rw-expand-btn:disabled {
    border-color: rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.05);
    color: var(--soft);
    cursor: not-allowed;
  }
  .rw-event {
    margin-bottom: 0.8rem;
    padding: 0.55rem 0.85rem;
    border-radius: 10px;
    font-size: 0.86rem;
    font-weight: 600;
    background: rgba(240, 164, 58, 0.16);
    border: 1px solid #f0a43a;
    color: #f9d59b;
  }
  .rw-event[data-tone="danger"] {
    background: rgba(232, 93, 63, 0.2);
    border-color: #ff4d3d;
    color: #ffb4a2;
  }
  .rw-event[hidden] {
    display: none;
  }
  .rw-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 310px;
    gap: 1rem;
    align-items: start;
  }
  .rw-canvas-wrap {
    position: relative;
    overflow-x: auto;
    background: #12181d;
    border-radius: 12px;
    padding: 4px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .rw-canvas-wrap canvas {
    display: block;
    margin: 0 auto;
    touch-action: none;
    cursor: crosshair;
  }
  .rw-overlay {
    position: absolute;
    inset: 0;
    background: rgba(13, 24, 30, 0.88);
    display: grid;
    place-items: center;
    padding: 1rem;
    border-radius: 12px;
  }
  .rw-overlay[hidden] {
    display: none;
  }
  .rw-modal {
    max-width: 440px;
    background: #1b313b;
    border: 1px solid #2ad4a5;
    border-radius: 14px;
    padding: 1.5rem;
    text-align: center;
  }
  .rw-modal h2 {
    margin: 0 0 0.5rem;
    color: #fff;
  }
  .rw-modal p {
    margin: 0 0 1.1rem;
    color: var(--soft);
  }
  .rw-modal-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
  }
  .rw-msg {
    margin: 0.6rem 0 0.9rem;
    font-size: 0.9rem;
    color: #2ad4a5;
  }
  .rw-upgrades-box {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 0.85rem;
  }
  .rw-upgrades-box h3 {
    margin: 0 0 0.65rem;
    font-size: 0.98rem;
    color: #fff;
  }
  .rw-upgrades-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 0.5rem;
  }
  .rw-upg {
    text-align: left;
    background: rgba(42, 212, 165, 0.1);
    border: 1.5px solid rgba(42, 212, 165, 0.35);
    border-radius: 9px;
    padding: 0.55rem 0.7rem;
    color: var(--limestone);
    cursor: pointer;
    font: inherit;
  }
  .rw-upg:disabled {
    opacity: 0.45;
    cursor: not-allowed;
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.1);
  }
  .rw-upg-top {
    display: flex;
    justify-content: space-between;
    gap: 0.4rem;
    font-size: 0.86rem;
    color: #fff;
  }
  .rw-upg-badge {
    font-size: 0.78rem;
    color: #2ad4a5;
    white-space: nowrap;
  }
  .rw-upg small {
    display: block;
    font-size: 0.75rem;
    color: var(--soft);
    margin-top: 0.2rem;
  }
  .rw-panel {
    display: grid;
    gap: 0.85rem;
  }
  .rw-box {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 0.85rem;
  }
  .rw-box h3 {
    margin: 0 0 0.6rem;
    font-size: 0.98rem;
    color: #fff;
  }
  .rw-tools {
    display: grid;
    gap: 0.42rem;
  }
  .rw-tool {
    text-align: left;
    background: rgba(255, 255, 255, 0.06);
    border: 1.5px solid rgba(255, 255, 255, 0.12);
    border-radius: 9px;
    padding: 0.48rem 0.65rem;
    color: var(--limestone);
    cursor: pointer;
    font: inherit;
  }
  .rw-tool[data-afford="false"] {
    opacity: 0.58;
  }
  .rw-tool[data-active="true"] {
    border-color: #2ad4a5;
    background: rgba(42, 212, 165, 0.16);
    opacity: 1;
  }
  .rw-tool-top {
    display: flex;
    justify-content: space-between;
    font-size: 0.88rem;
    color: #fff;
  }
  .rw-tool small {
    display: block;
    font-size: 0.74rem;
    color: var(--soft);
    margin-top: 0.12rem;
  }
  .rw-check {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    font-size: 0.82rem;
    color: var(--soft);
    margin-bottom: 0.5rem;
    cursor: pointer;
  }
  .rw-check:last-child {
    margin-bottom: 0;
  }
  .rw-check strong {
    color: #fff;
  }
  .rw-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .rw-btn {
    flex: 1 1 auto;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    border-radius: 8px;
    padding: 0.45rem 0.7rem;
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }
  .rw-btn:hover {
    background: rgba(255, 255, 255, 0.18);
  }
  .rw-meta {
    margin: 0;
    font-size: 0.78rem;
    color: var(--soft);
    text-align: center;
  }
  @media (max-width: 960px) {
    .rw-top-bar,
    .rw-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
