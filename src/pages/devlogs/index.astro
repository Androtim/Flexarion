---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const devlogs = (await getCollection("devlogs")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Devlogs Flexarion : Carnets de développement Veridia 2140"
  description="Suivez les devlogs techniques et artistiques de Flexarion Studio à Aix-en-Provence : worldbuilding Solarpunk, graphes hydriques et simulation."
  breadcrumbs={[
    { name: "Accueil", href: "/" },
    { name: "Devlogs", href: "/devlogs/" },
  ]}
>
  <section class="section">
    <div class="container">
      <span class="kicker">Silo 03 / Carnets de développement</span>
      <h1>Journal technique de Flexarion Studio.</h1>
      <p class="lead">
        Chaque carnet documente un aspect concret de la conception de <strong>Veridia 2140</strong> :
        ancrage provençal à Aix-en-Provence, algorithmes de simulation et choix graphiques.
      </p>

      <div class="grid-2" style="margin-top: 2.25rem;">
        {
          devlogs.map((post, idx) => (
            <article class="dispatch-item">
              <img src={post.data.image} alt={post.data.imageAlt} width="800" height="450" />
              <span class="kicker kicker-pine" style="margin-bottom: 0.45rem;">
                Carnet 0{idx + 1} · {post.data.tag} · {post.data.readingTime}
              </span>
              <h2>
                <a href={`/devlogs/${post.id}/`} style="color: var(--ink);">
                  {post.data.title}
                </a>
              </h2>
              <p>{post.data.description}</p>
              <p style="font-family: var(--font-mono); font-size: 0.78rem; color: var(--ink-faint); margin-bottom: 1rem;">
                {post.data.author} ·{" "}
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString("fr-FR", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </time>
              </p>
              <a href={`/devlogs/${post.id}/`} class="link-editorial">
                Lire l'article complet →
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
