---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ResponsivePicture from "../../components/ResponsivePicture.astro";
import { STUDIO } from "../../data/site";

export async function getStaticPaths() {
  const posts = await getCollection("devlogs");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);

const siteOrigin = Astro.site ? Astro.site.origin : "https://flexarion.alwaysdata.net";
const articleUrl = new URL(Astro.url.pathname, siteOrigin).href;
const otherDevlogs = allPosts.filter((p) => p.id !== post.id);

const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  image: new URL(post.data.image, siteOrigin).href,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: {
    "@type": "Organization",
    name: post.data.author,
  },
  publisher: {
    "@type": "Organization",
    name: STUDIO.legalName,
    logo: {
      "@type": "ImageObject",
      url: `${siteOrigin}/images/flexarion-logo.svg`,
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": articleUrl,
  },
};
---

<BaseLayout
  title={post.data.seoTitle}
  description={post.data.description}
  ogImage={post.data.image}
  preloadHeroBase={post.data.image.replace(/\.(jpg|jpeg|png|webp)$/i, "")}
  ogType="article"
  breadcrumbs={[
    { name: "Accueil", href: "/" },
    { name: "Devlogs", href: "/devlogs/" },
    { name: post.data.title, href: `/devlogs/${post.id}/` },
  ]}
  schemas={[blogPostingSchema]}
>
  <article class="section">
    <div class="container">
      <div style="max-width: 74ch;">
        <span class="kicker kicker-pine">{post.data.tag} · {post.data.readingTime}</span>
        <h1>{post.data.title}</h1>
        <p style="font-family: var(--font-mono); font-size: 0.82rem; color: var(--ink-faint); margin-bottom: 2rem;">
          Publié par <strong style="color: var(--ink);">{post.data.author}</strong> ({post.data.authorRole}) le{" "}
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString("fr-FR", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </time>
        </p>
      </div>

      <figure class="plate-frame" style="margin: 0 0 2.25rem; max-width: 920px;">
        <ResponsivePicture
          src={post.data.image}
          alt={post.data.imageAlt}
          width={1280}
          height={720}
          sizes="(max-width: 920px) 100vw, 920px"
          eager={true}
        />
        <figcaption class="plate-caption">
          <span>{post.data.imageAlt}</span>
          <span>Archive Flexarion</span>
        </figcaption>
      </figure>

      <aside class="panel-muted" style="max-width: 68ch; margin-bottom: 2.25rem;">
        <h2 style="font-size: 1.15rem; margin-bottom: 0.65rem;">
          Points clés de ce carnet (Synthèse GEO)
        </h2>
        <ul style="margin: 0; padding-left: 1.25rem; color: var(--ink-soft);">
          {post.data.summaryPoints.map((point) => <li>{point}</li>)}
        </ul>
      </aside>

      <div class="prose">
        <Content />
      </div>

      {
        otherDevlogs.length > 0 && (
          <section class="section-ruled" style="margin-top: 3.5rem; padding-top: 2rem;">
            <span class="kicker">Poursuivre dans le silo Devlogs</span>
            <h2>Autres carnets de développement</h2>
            <div class="grid-2" style="margin-top: 1.25rem;">
              {otherDevlogs.map((other) => (
                <article class="dispatch-item">
                  <span class="kicker kicker-pine" style="margin-bottom: 0.45rem;">{other.data.tag}</span>
                  <h3>
                    <a href={`/devlogs/${other.id}/`} style="color: var(--ink);">
                      {other.data.title}
                    </a>
                  </h3>
                  <p>{other.data.description}</p>
                  <a href={`/devlogs/${other.id}/`} class="link-editorial">Lire cet article →</a>
                </article>
              ))}
            </div>
          </section>
        )
      }
    </div>
  </article>
</BaseLayout>
