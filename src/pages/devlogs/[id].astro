---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ResponsivePicture from "../../components/ResponsivePicture.astro";
import { STUDIO } from "../../data/site";

export async function getStaticPaths() {
  const posts = await getCollection("devlogs");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);

const siteOrigin = Astro.site ? Astro.site.origin : "https://flexarion.alwaysdata.net";
const articleUrl = new URL(Astro.url.pathname, siteOrigin).href;
const otherDevlogs = allPosts.filter((p) => p.id !== post.id);

const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  image: new URL(post.data.image, siteOrigin).href,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: {
    "@type": "Organization",
    name: post.data.author,
  },
  publisher: {
    "@type": "Organization",
    "@id": `${siteOrigin}/#organization`,
    name: STUDIO.name,
    logo: {
      "@type": "ImageObject",
      url: `${siteOrigin}/images/flexarion-logo.png`,
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": articleUrl,
  },
};
---

<BaseLayout
  title={post.data.seoTitle}
  description={post.data.description}
  ogImage={post.data.image}
  preloadHeroBase={post.data.image.replace(/\.(jpg|jpeg|png|webp)$/i, "")}
  ogType="article"
  breadcrumbs={[
    { name: "Accueil", href: "/" },
    { name: "Devlogs", href: "/devlogs/" },
    { name: post.data.title, href: `/devlogs/${post.id}/` },
  ]}
  schemas={[blogPostingSchema]}
>
  <article>
    <header class="wrap article-head">
      <p class="post-meta">
        {post.data.tag} · {post.data.readingTime}
      </p>
      <h1>{post.data.title.replace(/ ([:?!;])/g, "\u00a0$1")}</h1>
      <p class="post-meta">
        Par <strong>{post.data.author}</strong> ({post.data.authorRole}), le{" "}
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString("fr-FR", { year: "numeric", month: "long", day: "numeric" })}
        </time>
      </p>
    </header>

    <figure class="wrap photo" style="max-width: 980px; margin-inline: auto;">
      <ResponsivePicture
        src={post.data.image}
        alt={post.data.imageAlt}
        width={1280}
        height={720}
        sizes="(max-width: 980px) 100vw, 980px"
        eager={true}
      />
      <figcaption>{post.data.imageAlt}</figcaption>
    </figure>

    <div class="wrap" style="padding-bottom: 4rem;">
      <aside class="takeaways prose">
        <h2>En bref</h2>
        <ul>
          {post.data.summaryPoints.map((point) => <li>{point}</li>)}
        </ul>
      </aside>
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>

  {
    otherDevlogs.length > 0 && (
      <section class="block block-chalk" aria-labelledby="more-heading">
        <div class="wrap">
          <h2 id="more-heading">À lire ensuite</h2>
          <div class="post-list">
            {otherDevlogs.map((other) => (
              <article class="post">
                <a href={`/devlogs/${other.id}/`} tabindex="-1" aria-hidden="true">
                  <ResponsivePicture src={other.data.image} alt={other.data.imageAlt} width={1280} height={720} sizes="(max-width: 720px) 100vw, 520px" />
                </a>
                <div>
                  <p class="post-meta">{other.data.tag}</p>
                  <h3>
                    <a href={`/devlogs/${other.id}/`}>{other.data.title}</a>
                  </h3>
                  <p>{other.data.description}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
