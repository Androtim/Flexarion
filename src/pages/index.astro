---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqSection from "../components/FaqSection.astro";
import ResponsivePicture from "../components/ResponsivePicture.astro";
import { STUDIO } from "../data/site";

const allDevlogs = await getCollection("devlogs");
const recentDevlogs = allDevlogs.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const homeFaqs = [
  {
    question: "Qu'est-ce que Flexarion Studio ?",
    answer:
      "Flexarion est un concept de studio de développement de jeux vidéo indépendant basé à Aix-en-Provence (France), créé dans le cadre du BUT Informatique à l'IUT d'Aix-Marseille et spécialisé dans la science-fiction Solarpunk.",
  },
  {
    question: "Quel est le premier jeu imaginé par Flexarion ?",
    answer:
      "Le projet phare de Flexarion est Veridia 2140, un city-builder et jeu de stratégie éco-futuriste situé en Provence en 2140, autour de dômes géodésiques en calcaire solaire et de réseaux hydriques mycéliens.",
  },
  {
    question: "Où suivre les actualités et carnets techniques de Flexarion ?",
    answer:
      "Les carnets de développement sont publiés sur ce site dans la section Devlogs et relayés sur notre compte Instagram principal @flexarion (le compte @flexarion_official sert uniquement de redirection).",
  },
];
---

<BaseLayout
  title="Flexarion Studio : Jeux vidéo Solarpunk à Aix-en-Provence"
  description="Flexarion est un studio indépendant de jeux vidéo basé à Aix-en-Provence, créateur de Veridia 2140 : stratégie Solarpunk et simulation systémique."
  preloadHeroBase="/images/veridia-hero"
>
  <section class="section">
    <div class="container hero-editorial">
      <div>
        <span class="kicker">00 / Studio Indépendant, Aix-en-Provence</span>
        <h1>Imaginer une science-fiction lumineuse depuis la Provence.</h1>
        <p class="lead">
          Fondé à <strong>Aix-en-Provence</strong> par des étudiants en informatique,{" "}
          <strong>Flexarion</strong> explore des jeux de stratégie où la rigueur des systèmes hydrauliques
          et thermiques nourrit un futur méditerranéen habitable.
        </p>

        <div class="actions">
          <a href="/jeux/veridia-2140/" class="btn btn-primary">Explorer Veridia 2140</a>
          <a href="/studio/" class="link-editorial">Découvrir le studio</a>
        </div>

        <div class="specs-strip" aria-label="Repères clés du studio Flexarion">
          <div class="spec-cell">
            <span class="spec-label">Ancrage</span>
            <span class="spec-value">Aix-en-Provence</span>
          </div>
          <div class="spec-cell">
            <span class="spec-label">Genre</span>
            <span class="spec-value">SF Solarpunk</span>
          </div>
          <div class="spec-cell">
            <span class="spec-label">Projet phare</span>
            <span class="spec-value">Veridia 2140</span>
          </div>
        </div>
      </div>

      <figure class="plate-frame">
        <ResponsivePicture
          src="/images/veridia-hero.jpg"
          alt="Illustration de Veridia 2140 par Flexarion Studio : dômes solaires méditerranéens et montagne Sainte-Victoire"
          width={1280}
          height={720}
          eager={true}
        />
        <figcaption class="plate-caption">
          <span>Planche 01 · Bassin aixois et Sainte-Victoire (2140)</span>
          <span>Flexarion Studio</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section-tight section-ruled" aria-labelledby="pillars-heading">
    <div class="container">
      <span class="kicker kicker-pine">01 / Architecture éditoriale</span>
      <h2 id="pillars-heading">Trois dossiers pour explorer Flexarion</h2>
      <p class="lead">
        Notre site suit une structure claire : le studio aixois, le dossier du jeu phare Veridia 2140 et
        nos carnets de recherche technique.
      </p>

      <div class="archival-list">
        <article class="archival-row">
          <span class="archival-num">01</span>
          <h3>Le Studio à Aix-en-Provence</h3>
          <p>
            Histoire du collectif, quatre pôles de compétences complémentaires, manifeste Solarpunk et
            politique de transparence sur nos outils.
          </p>
          <a href="/studio/" class="link-editorial">Ouvrir le dossier →</a>
        </article>

        <article class="archival-row">
          <span class="archival-num">02</span>
          <h3>Veridia 2140 (Jeu Phare)</h3>
          <p>
            City-builder tactique en restanques calcaires : gravité hydraulique, pergolas photovoltaïques et
            thermorégulation par réseau mycélien.
          </p>
          <a href="/jeux/veridia-2140/" class="link-editorial">Voir la fiche →</a>
        </article>

        <article class="archival-row">
          <span class="archival-num">03</span>
          <h3>Carnets de Développement</h3>
          <p>
            Deux articles détaillés sur nos choix visuels provençaux et la modélisation des aqueducs par
            graphes orientés pondérés.
          </p>
          <a href="/devlogs/" class="link-editorial">Lire les carnets →</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section-tight section-ruled" aria-labelledby="devlogs-heading">
    <div class="container">
      <span class="kicker">02 / Publications récentes</span>
      <h2 id="devlogs-heading">Derniers carnets techniques</h2>
      <div class="grid-2" style="margin-top: 1.75rem;">
        {
          recentDevlogs.map((post, idx) => (
            <article class="dispatch-item">
              <ResponsivePicture
                src={post.data.image}
                alt={post.data.imageAlt}
                width={1280}
                height={720}
                sizes="(max-width: 760px) 100vw, 560px"
                eager={false}
              />
              <span class="kicker kicker-pine" style="margin-bottom: 0.45rem;">
                Carnet 0{idx + 1} · {post.data.tag} · {post.data.readingTime}
              </span>
              <h3>
                <a href={`/devlogs/${post.id}/`} style="color: var(--ink);">
                  {post.data.title}
                </a>
              </h3>
              <p>{post.data.description}</p>
              <a href={`/devlogs/${post.id}/`} class="link-editorial">
                Lire le carnet →
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <FaqSection
    title="Tout comprendre sur Flexarion en 3 réponses"
    subtitle="Les repères factuels sur notre collectif aixois et le concept Veridia 2140."
    items={homeFaqs}
  />

  <section class="section-tight section-ruled">
    <div class="container">
      <div class="panel" style="display: flex; justify-content: space-between; align-items: center; gap: 1.75rem; flex-wrap: wrap;">
        <div style="max-width: 58ch;">
          <span class="kicker" style="margin-bottom: 0.4rem;">04 / Suivre l'avancée du projet</span>
          <h2 style="margin-bottom: 0.45rem;">Retrouvez Flexarion sur Instagram</h2>
          <p style="margin: 0;">
            Concept arts inédits, coulisses de développement et échanges directs sur{" "}
            <strong>{STUDIO.instagramHandle}</strong>, ou consultez notre kit presse.
          </p>
        </div>
        <div class="actions" style="margin-top: 0;">
          <a href={STUDIO.instagramMain} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            Instagram @flexarion
          </a>
          <a href="/contact/" class="btn btn-secondary">Contact &amp; Presse</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
