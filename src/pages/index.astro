---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqSection from "../components/FaqSection.astro";
import Panorama from "../components/Panorama.astro";
import ResponsivePicture from "../components/ResponsivePicture.astro";

const devlogs = (await getCollection("devlogs")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const dateFr = (d: Date) => d.toLocaleDateString("fr-FR", { year: "numeric", month: "long", day: "numeric" });

const homeFaqs = [
  {
    question: "Qu'est-ce que Flexarion ?",
    answer:
      "Flexarion est un studio indépendant de jeux vidéo de science-fiction basé à Aix-en-Provence. C'est un studio fictif, créé par des étudiants en BUT Informatique à l'IUT d'Aix-Marseille dans le cadre d'un projet de communication.",
  },
  {
    question: "Sur quels jeux travaille Flexarion ?",
    answer:
      "Notre premier jeu, Veridia 2140 (v0.4), est un puzzle de viaducs gratuit centré sur l'eau à Aix-en-Provence. Notre deuxième projet en développement, REWIRE, est un jeu procédural 100 % centré sur la transition d'une industrie électrique brutaliste vers l'électricité verte, co-construit en Reels.",
  },
  {
    question: "Où suivre l'actualité de Flexarion ?",
    answer:
      "Les devlogs sont publiés sur ce site, et les coulisses sur Instagram (@flexarion). Le compte @flexarion.official redirige vers le compte principal.",
  },
];
---

<BaseLayout
  title="Flexarion : jeux vidéo de science-fiction à Aix-en-Provence"
  description="Flexarion est un studio indépendant de jeux vidéo de science-fiction à Aix-en-Provence. Nous créons Veridia 2140, un jeu de viaducs gratuit dans Aix en 2140."
>
  <section class="hero">
    <div class="wrap hero-text">
      <h1>Flexarion fait des jeux où chaque goutte d'eau compte.</h1>
      <p class="lead">
        Studio de science-fiction à Aix-en-Provence. Notre premier jeu, <strong>Veridia 2140</strong>,
        vous confie l'eau de la ville au pied de la Sainte-Victoire : des tuyaux, des viaducs, et
        quarante secondes par jour pour que personne n'ait soif.
      </p>
      <div class="actions">
        <a href="/jouer/" class="btn btn-sun">Jouer gratuitement</a>
        <a href="/jeux/veridia-2140/" class="btn btn-ghost">Découvrir Veridia 2140</a>
      </div>
    </div>
    <Panorama />
  </section>

  <section class="block" aria-labelledby="play-heading">
    <div class="wrap">
      <div class="narrow">
        <h2 id="play-heading">Comment on joue</h2>
        <p class="lead">
          Veridia 2140 n'a ni ennemis ni armée. Votre adversaire, c'est la soif : chaque jour, une nouvelle
          carte d'Aix, et quarante secondes pour servir tous les quartiers.
        </p>
      </div>

      <div>
        <article class="mechanic">
          <div>
            <span class="tag">Tracer</span>
            <h3>De la source aux quartiers</h3>
            <p>
              Glissez pour poser des tuyaux depuis le Canal de Provence jusqu'à Mazarin, Les Milles ou Jas
              de Bouffan. Pour franchir l'Arc, il faut un viaduc, et il coûte double.
            </p>
          </div>
          <figure class="diagram shot">
            <ResponsivePicture src="/images/jeu-reseau.jpg" alt="Réseau de tuyaux tracé du Canal de Provence vers quatre quartiers d'Aix, avec un viaduc au-dessus de l'Arc" width={1280} height={960} />
          </figure>
        </article>

        <article class="mechanic">
          <div>
            <span class="tag">Partager</span>
            <h3>Assez d'eau pour tout le monde ?</h3>
            <p>
              Vannes ouvertes, l'eau avance et se partage à chaque embranchement. Plus il y a de quartiers,
              plus il faut penser son réseau : un seul tuyau ne suffit plus.
            </p>
          </div>
          <figure class="diagram shot">
            <ResponsivePicture src="/images/jeu-partage.jpg" alt="L'eau turquoise circule dans les tuyaux et remplit les jauges des quartiers" width={1280} height={960} />
          </figure>
        </article>

        <article class="mechanic">
          <div>
            <span class="tag">Tenir</span>
            <h3>Urgences et améliorations</h3>
            <p>
              Un feu de garrigue, un hôpital à sec : quelques secondes pour y amener l'eau. Le soir, vous
              améliorez la vitesse, l'eau ou le nombre de tuyaux, car demain sera plus dur.
            </p>
          </div>
          <figure class="diagram shot">
            <ResponsivePicture src="/images/jeu-boutique.jpg" alt="Bilan de la journée et choix des améliorations" width={1280} height={960} />
          </figure>
        </article>
      </div>

      <div class="actions">
        <a href="/jeux/veridia-2140/" class="btn btn-water">La fiche complète du jeu</a>
      </div>
    </div>
  </section>

  <section class="block block-dusk" aria-labelledby="rewire-heading">
    <div class="wrap split">
      <div>
        <span class="tag" style="background: rgba(42, 212, 165, 0.16); color: #2AD4A5;">Nouveau jeu en développement</span>
        <h2 id="rewire-heading">REWIRE : du brutalisme à l'électricité verte</h2>
        <p class="lead">
          Maintenant que <strong>Veridia 2140</strong> a atteint sa version 0.4, nous lançons notre deuxième
          projet : un jeu procédural 100 % centré sur l'électricité, entre logistique de réseau et
          renaturation du béton.
        </p>
        <p>
          Le développement se fait en ouvert via une série de Reels interactifs où vos votes en commentaire
          décident des mécaniques ajoutées au jeu.
        </p>
        <div class="actions">
          <a href="/jeux/rewire/" class="btn btn-sun">Découvrir REWIRE</a>
          <a href="/devlogs/annonce-rewire-electricite-verte/" class="btn btn-ghost">Lire le devlog #7</a>
        </div>
      </div>
      <figure class="photo">
        <ResponsivePicture
          src="/images/rewire-hero.jpg"
          alt="REWIRE par Flexarion : transition d'une centrale brutaliste vers un réseau d'électricité verte"
          width={1280}
          height={720}
          sizes="(max-width: 860px) 100vw, 540px"
        />
        <figcaption>REWIRE : recâblez le réseau, libérez le béton.</figcaption>
      </figure>
    </div>
  </section>

  <section class="block block-chalk" aria-labelledby="devlogs-heading">
    <div class="wrap">
      <h2 id="devlogs-heading">Derniers devlogs</h2>
      <div class="post-list">
        {
          devlogs.map((post) => (
            <article class="post">
              <a href={`/devlogs/${post.id}/`} tabindex="-1" aria-hidden="true">
                <ResponsivePicture
                  src={post.data.image}
                  alt={post.data.imageAlt}
                  width={1280}
                  height={720}
                  sizes="(max-width: 720px) 100vw, 520px"
                />
              </a>
              <div>
                <p class="post-meta">
                  <time datetime={post.data.pubDate.toISOString()}>{dateFr(post.data.pubDate)}</time> ·{" "}
                  {post.data.readingTime}
                </p>
                <h3>
                  <a href={`/devlogs/${post.id}/`}>{post.data.title}</a>
                </h3>
                <p>{post.data.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="block block-dusk" aria-labelledby="studio-heading">
    <div class="wrap split">
      <div>
        <h2 id="studio-heading">Un petit studio, à Aix</h2>
        <p class="lead">
          Flexarion, ce sont des étudiants en informatique de l'IUT d'Aix-Marseille qui ont eu envie d'une
          science-fiction qui se passe ici, sous ce soleil-là, avec ces problèmes d'eau-là.
        </p>
        <p>
          Le studio est fictif et rien n'est vendu sur ce site. Le travail, lui, est réel : le site, le code
          et les devlogs sont publics.
        </p>
        <div class="actions">
          <a href="/studio/" class="btn btn-sun">Le studio</a>
          <a href="/contact/" class="btn btn-ghost">Nous écrire</a>
        </div>
      </div>
      <figure class="photo">
        <ResponsivePicture
          src="/images/veridia-hero.jpg"
          alt="Illustration de Veridia 2140 : dômes solaires, aqueduc et montagne Sainte-Victoire au coucher du soleil"
          width={1280}
          height={720}
          sizes="(max-width: 860px) 100vw, 540px"
        />
        <figcaption>Recherche visuelle pour Veridia 2140, le bassin aixois au crépuscule.</figcaption>
      </figure>
    </div>
  </section>

  <FaqSection title="Questions fréquentes sur Flexarion" items={homeFaqs} />
</BaseLayout>
