---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqSection from "../components/FaqSection.astro";
import Panorama from "../components/Panorama.astro";
import MechanicDiagram from "../components/MechanicDiagram.astro";
import ResponsivePicture from "../components/ResponsivePicture.astro";

const devlogs = (await getCollection("devlogs")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const dateFr = (d: Date) => d.toLocaleDateString("fr-FR", { year: "numeric", month: "long", day: "numeric" });

const homeFaqs = [
  {
    question: "Qu'est-ce que Flexarion ?",
    answer:
      "Flexarion est un studio indépendant de jeux vidéo de science-fiction basé à Aix-en-Provence. C'est un studio fictif, créé par des étudiants en BUT Informatique à l'IUT d'Aix-Marseille dans le cadre d'un projet de communication.",
  },
  {
    question: "Sur quel jeu travaille Flexarion ?",
    answer:
      "Flexarion conçoit Veridia 2140, un city-builder Solarpunk qui se déroule dans le Pays d'Aix en 2140. Le joueur gère l'eau d'une cité de sept dômes reliés par des aqueducs, sans pompe, uniquement par gravité.",
  },
  {
    question: "Où suivre l'actualité de Flexarion ?",
    answer:
      "Les devlogs sont publiés sur ce site, et les coulisses sur Instagram (@flexarion). Le compte @flexarion.official redirige vers le compte principal.",
  },
];
---

<BaseLayout
  title="Flexarion : jeux vidéo de science-fiction à Aix-en-Provence"
  description="Flexarion est un studio indépendant de jeux vidéo de science-fiction à Aix-en-Provence. Nous créons Veridia 2140, un city-builder Solarpunk en Provence."
>
  <section class="hero">
    <div class="wrap hero-text">
      <h1>Flexarion fait des jeux où l'eau coule vers le bas.</h1>
      <p class="lead">
        Studio de science-fiction à Aix-en-Provence. Notre premier jeu, <strong>Veridia 2140</strong>,
        vous confie une cité de sept dômes au pied de la Sainte-Victoire, un été record, et pas une seule
        pompe.
      </p>
      <div class="actions">
        <a href="/jeux/veridia-2140/" class="btn btn-sun">Découvrir Veridia 2140</a>
        <a href="/studio/" class="btn btn-ghost">Qui sommes-nous ?</a>
      </div>
    </div>
    <Panorama />
  </section>

  <section class="block" aria-labelledby="play-heading">
    <div class="wrap">
      <div class="narrow">
        <h2 id="play-heading">Comment on joue</h2>
        <p class="lead">
          Veridia 2140 n'a ni ennemis ni armée. Votre adversaire, c'est l'été. Trois systèmes physiques
          décident si vos quartiers tiennent jusqu'à septembre.
        </p>
      </div>

      <div>
        <article class="mechanic">
          <div>
            <span class="tag">L'eau</span>
            <h3>Tout descend par gravité</h3>
            <p>
              Le réservoir est en haut, la ville en bas. Chaque aqueduc que vous tracez doit garder sa pente :
              un mètre de trop et l'eau stagne, un mètre de moins et le quartier suivant a soif.
            </p>
          </div>
          <MechanicDiagram type="water" label="Schéma : l'eau descend du réservoir vers l'Arbois puis vers la ville, par gravité." />
        </article>

        <article class="mechanic">
          <div>
            <span class="tag">Le réseau</span>
            <h3>Le sol qui rafraîchit la ville</h3>
            <p>
              Sous les restanques, un mycélium cultivé transporte l'humidité des bassins frais vers les rues
              surchauffées. S'il manque d'eau, il s'endort, et sa lumière s'éteint sur la carte.
            </p>
          </div>
          <MechanicDiagram type="mycelium" label="Schéma : le réseau mycélien transporte l'humidité d'un bassin frais vers les rues à 41 °C." />
        </article>

        <article class="mechanic">
          <div>
            <span class="tag">Le verre</span>
            <h3>Des dômes qui suivent le soleil</h3>
            <p>
              Orientez les panneaux d'un dôme plein sud et il produit beaucoup d'énergie, mais chauffe le
              quartier. Ouvrez-le à l'est et il respire mieux le soir. Chaque choix a un coût.
            </p>
          </div>
          <MechanicDiagram type="dome" label="Schéma : course du soleil de 8 h à 18 h au-dessus d'un dôme de verre solaire." />
        </article>
      </div>

      <div class="actions">
        <a href="/jeux/veridia-2140/" class="btn btn-water">La fiche complète du jeu</a>
      </div>
    </div>
  </section>

  <section class="block block-chalk" aria-labelledby="devlogs-heading">
    <div class="wrap">
      <h2 id="devlogs-heading">Derniers devlogs</h2>
      <div class="post-list">
        {
          devlogs.map((post) => (
            <article class="post">
              <a href={`/devlogs/${post.id}/`} tabindex="-1" aria-hidden="true">
                <ResponsivePicture
                  src={post.data.image}
                  alt={post.data.imageAlt}
                  width={1280}
                  height={720}
                  sizes="(max-width: 720px) 100vw, 520px"
                />
              </a>
              <div>
                <p class="post-meta">
                  <time datetime={post.data.pubDate.toISOString()}>{dateFr(post.data.pubDate)}</time> ·{" "}
                  {post.data.readingTime}
                </p>
                <h3>
                  <a href={`/devlogs/${post.id}/`}>{post.data.title}</a>
                </h3>
                <p>{post.data.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="block block-dusk" aria-labelledby="studio-heading">
    <div class="wrap split">
      <div>
        <h2 id="studio-heading">Un petit studio, à Aix</h2>
        <p class="lead">
          Flexarion, ce sont des étudiants en informatique de l'IUT d'Aix-Marseille qui ont eu envie d'une
          science-fiction qui se passe ici, sous ce soleil-là, avec ces problèmes d'eau-là.
        </p>
        <p>
          Le studio est fictif et rien n'est vendu sur ce site. Le travail, lui, est réel : le site, le code
          et les devlogs sont publics.
        </p>
        <div class="actions">
          <a href="/studio/" class="btn btn-sun">Le studio</a>
          <a href="/contact/" class="btn btn-ghost">Nous écrire</a>
        </div>
      </div>
      <figure class="photo">
        <ResponsivePicture
          src="/images/veridia-hero.jpg"
          alt="Illustration de Veridia 2140 : dômes solaires, aqueduc et montagne Sainte-Victoire au coucher du soleil"
          width={1280}
          height={720}
          sizes="(max-width: 860px) 100vw, 540px"
        />
        <figcaption>Recherche visuelle pour Veridia 2140, le bassin aixois au crépuscule.</figcaption>
      </figure>
    </div>
  </section>

  <FaqSection title="Questions fréquentes sur Flexarion" items={homeFaqs} />
</BaseLayout>
