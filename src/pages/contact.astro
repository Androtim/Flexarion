---
import BaseLayout from "../layouts/BaseLayout.astro";
import { STUDIO } from "../data/site";
---

<BaseLayout
  title="Contact et Kit Presse : Flexarion Studio à Aix-en-Provence"
  description="Contactez Flexarion Studio à Aix-en-Provence : demandes presse, kit média officiel de Veridia 2140 et réseaux sociaux officiels (@flexarion)."
  breadcrumbs={[
    { name: "Accueil", href: "/" },
    { name: "Contact & Presse", href: "/contact/" },
  ]}
>
  <header class="wrap page-head">
    <h1>Contacter Flexarion.</h1>
    <p class="lead narrow">
      Journaliste, étudiant, curieux ou joueur : voici où nous trouver, et tout ce qu'il faut pour parler de
      <strong>Veridia 2140</strong>.
    </p>
  </header>

  <section class="block block-chalk" style="padding-top: 3rem;">
    <div class="wrap cards" style="margin-top: 0;">
      <article class="card">
        <h2 style="font-size: 1.6rem;">Nous trouver</h2>
        <ul class="plain-list">
          <li><strong>Où :</strong> Aix-en-Provence, Bouches-du-Rhône</li>
          <li>
            <strong>Instagram :</strong>{" "}
            <a href={STUDIO.instagramMain} target="_blank" rel="noopener noreferrer">{STUDIO.instagramHandle}</a>
            {" "}(et {STUDIO.instagramBackupHandle}, qui redirige vers le compte principal)
          </li>
          <li>
            <strong>YouTube :</strong>{" "}
            <a href={STUDIO.youtube} target="_blank" rel="noopener noreferrer">chaîne Flexarion</a>
          </li>
          <li>
            <strong>X :</strong>{" "}
            <a href={STUDIO.x} target="_blank" rel="noopener noreferrer">{STUDIO.xHandle}</a>
          </li>
          <li>
            <strong>TikTok :</strong>{" "}
            <a href={STUDIO.tiktok} target="_blank" rel="noopener noreferrer">@flexarion_studio</a>
          </li>
          <li>
            <strong>itch.io :</strong>{" "}
            <a href={STUDIO.itch} target="_blank" rel="noopener noreferrer">flexarion-studio.itch.io</a>
          </li>
          <li>
            <strong>Game Jolt :</strong>{" "}
            <a href={STUDIO.gamejolt} target="_blank" rel="noopener noreferrer">Veridia 2140 sur Game Jolt</a>
          </li>
          <li>
            <strong>Code et documentation :</strong>{" "}
            <a href={STUDIO.githubRepo} target="_blank" rel="noopener noreferrer">GitHub</a>
          </li>
          <li><strong>Cadre :</strong> studio fictif, projet de BUT Informatique à l'IUT d'Aix-Marseille</li>
        </ul>
      </article>
      <article class="card">
        <h2 style="font-size: 1.6rem;">Dossier de presse</h2>
        <ul class="plain-list">
          <li><strong>Studio :</strong> Flexarion, Aix-en-Provence, fondé en 2026</li>
          <li><strong>Jeu :</strong> Veridia 2140, city-builder Solarpunk</li>
          <li><strong>Modèle imaginé :</strong> achat unique sur PC, sans microtransaction (non commercialisé)</li>
        </ul>
        <p style="margin: 1rem 0 0.5rem;"><strong>Visuels à télécharger</strong></p>
        <ul class="plain-list">
          <li><a href="/images/flexarion-logo.svg" download>Logo Flexarion (SVG)</a> · <a href="/images/flexarion-logo.png" download>PNG</a></li>
          <li><a href="/images/veridia-hero.jpg" download>Illustration principale de Veridia 2140</a></li>
          <li><a href="/images/devlog-hydrology.jpg" download>Illustration : canaux sous un dôme</a></li>
        </ul>
      </article>
    </div>
  </section>
</BaseLayout>
