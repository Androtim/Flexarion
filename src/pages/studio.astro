---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResponsivePicture from "../components/ResponsivePicture.astro";
import { STUDIO } from "../data/site";

const teamMembers = [
  {
    code: "Pôle 01",
    name: "Timothée B. (Androtim)",
    role: "Architecture Logicielle, Simulation & SEO Technique",
    bio: "Conception du modèle de flux par graphes, gouvernance Git/CI et optimisation Core Web Vitals.",
  },
  {
    code: "Pôle 02",
    name: "Membre 2 (À compléter)",
    role: "Game Design & Équilibrage Systémique",
    bio: "Modélisation des courbes climatiques, ergonomie des restanques et scénarios de crise hydrique.",
  },
  {
    code: "Pôle 03",
    name: "Membre 3 (À compléter)",
    role: "Direction Artistique Solarpunk & UI/UX",
    bio: "Identité visuelle papier calcaire, encre profonde, pin et terre cuite ; recherche iconographique provençale.",
  },
  {
    code: "Pôle 04",
    name: "Membre 4 (À compléter)",
    role: "Narration, Devlogs & Community Management",
    bio: "Écriture de l'univers 2140, animation éditoriale de @flexarion et relations presse jeux indépendants.",
  },
];
---

<BaseLayout
  title="Le Studio Flexarion : Équipe et Histoire à Aix-en-Provence"
  description="Découvrez l'histoire de Flexarion Studio à Aix-en-Provence, notre manifeste Solarpunk méditerranéen et notre politique de transparence sur l'IA."
  preloadHeroBase="/images/veridia-hero"
  breadcrumbs={[
    { name: "Accueil", href: "/" },
    { name: "Le Studio", href: "/studio/" },
  ]}
>
  <section class="section">
    <div class="container hero-editorial">
      <div>
        <span class="kicker">Silo 01 / Le Studio à Aix-en-Provence</span>
        <h1>Le studio Flexarion, né au pied de la Sainte-Victoire.</h1>
        <p class="lead">
          Imaginé en 2026 par des étudiants de l'IUT d'Aix-Marseille, <strong>Flexarion Studio</strong>
          développe une approche singulière du jeu vidéo de science-fiction : relier l'ingénierie
          informatique à des récits écologiques méditerranéens.
        </p>
        <p>
          Plutôt que de reproduire des mégapoles dystopiques interchangeables, nous observons la pierre
          calcaire locale, les restanques et la question de l'eau en Provence pour concevoir un univers
          cohérent et documenté.
        </p>
        <p style="font-size: 0.9rem; color: var(--ink-faint);">
          <strong>Transparence académique :</strong> Flexarion est un studio fictif imaginé dans le cadre du
          module <em>Plan de communication et webmarketing à l'ère de l'IA</em> (BUT Informatique, IUT d'Aix-Marseille).
        </p>
      </div>

      <figure class="plate-frame">
        <ResponsivePicture
          src="/images/veridia-hero.jpg"
          alt="Territoire provençal futuriste imaginé par Flexarion Studio à Aix-en-Provence"
          width={1280}
          height={720}
          eager={true}
        />
        <figcaption class="plate-caption">
          <span>Inspiration territoriale : Aix-en-Provence et plateau de l'Arbois</span>
          <span>2026</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section-tight section-ruled" aria-labelledby="team-heading">
    <div class="container">
      <span class="kicker kicker-pine">02 / L'équipe fondatrice</span>
      <h2 id="team-heading">Quatre pôles complémentaires basés en Provence</h2>
      <p class="lead">
        Une organisation inspirée d'un vrai studio indépendant où programmation, design et communication
        travaillent main dans la main.
      </p>

      <div class="archival-list">
        {
          teamMembers.map((member) => (
            <article class="archival-row">
              <span class="archival-num">{member.code}</span>
              <div>
                <h3 style="margin-bottom: 0.25rem;">{member.name}</h3>
                <span style="font-family: var(--font-mono); font-size: 0.78rem; color: var(--pine);">
                  {member.role}
                </span>
              </div>
              <p>{member.bio}</p>
              <span style="font-family: var(--font-mono); font-size: 0.78rem; color: var(--ink-faint);">
                Aix-en-Provence
              </span>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-tight section-ruled" aria-labelledby="manifesto-heading">
    <div class="container grid-2">
      <article class="panel">
        <span class="kicker">Manifeste Solarpunk</span>
        <h2 id="manifesto-heading">Notre philosophie de création</h2>
        <p>
          Nous défendons des jeux de gestion respectueux du joueur : zéro monétisation intrusive, des
          systèmes lisibles fondés sur la physique des ressources et une écriture relue par des humains.
        </p>
        <a href="/jeux/veridia-2140/" class="link-editorial">Consulter le dossier Veridia 2140 →</a>
      </article>

      <article class="panel-muted">
        <span class="kicker kicker-pine">Éthique &amp; Transparence IA</span>
        <h2>Usage encadré de l'intelligence artificielle</h2>
        <p>
          Flexarion recourt à l'IA pour explorer des visuels conceptuels, structurer son code et automatiser
          les contrôles SEO techniques. La direction artistique, l'esprit critique et la voix éditoriale
          restent sous contrôle humain.
        </p>
        <a href={STUDIO.githubRepo} target="_blank" rel="noopener noreferrer" class="link-editorial">
          Consulter le journal technique sur GitHub →
        </a>
      </article>
    </div>
  </section>
</BaseLayout>
