---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResponsivePicture from "../components/ResponsivePicture.astro";
import { STUDIO } from "../data/site";

const roles = [
  {
    role: "Programmation et simulation",
    who: "Timothée B. (Androtim)",
    text: "Le moteur de simulation de l'eau et de la chaleur, le site et les outils de test.",
  },
  {
    role: "Game design",
    who: "Présentation à venir",
    text: "L'équilibrage des étés, la progression du joueur, les scénarios de crise.",
  },
  {
    role: "Direction artistique",
    who: "Présentation à venir",
    text: "Le style visuel de Veridia, le logo, les planches de recherche.",
  },
  {
    role: "Écriture et communauté",
    who: "Présentation à venir",
    text: "L'univers de 2140, les devlogs, Instagram et les échanges avec la presse.",
  },
];
---

<BaseLayout
  title="Le Studio Flexarion : Équipe et Histoire à Aix-en-Provence"
  description="Découvrez l'histoire de Flexarion Studio à Aix-en-Provence, notre manifeste Solarpunk méditerranéen et notre politique de transparence sur l'IA."
  preloadHeroBase="/images/veridia-hero"
  breadcrumbs={[
    { name: "Accueil", href: "/" },
    { name: "Le Studio", href: "/studio/" },
  ]}
>
  <header class="wrap page-head split">
    <div>
      <h1>Le studio Flexarion, à Aix-en-Provence.</h1>
      <p class="lead">
        Flexarion est né en 2026 sur les bancs de l'IUT d'Aix-Marseille. Nous sommes étudiants en
        informatique, et nous voulions une science-fiction qui se passe chez nous.
      </p>
      <p>
        Pas de mégapole sous la pluie néon : la Provence a ses propres questions d'avenir, à commencer par
        l'eau. Le calcaire, les restanques, les canaux et les étés de plus en plus longs nous donnent assez
        de matière pour un jeu entier.
      </p>
      <p class="note">
        Flexarion est un studio fictif, créé pour le module « Plan de communication et webmarketing à l'ère
        de l'IA » du BUT Informatique. Rien n'est vendu sur ce site.
      </p>
    </div>
    <figure class="photo">
      <ResponsivePicture
        src="/images/veridia-hero.jpg"
        alt="Le Pays d'Aix imaginé en 2140 par Flexarion, avec la montagne Sainte-Victoire"
        width={1280}
        height={720}
        eager={true}
      />
      <figcaption>Notre terrain de jeu : le Pays d'Aix, de l'Arbois à la Sainte-Victoire.</figcaption>
    </figure>
  </header>

  <section class="block block-chalk" aria-labelledby="team-heading">
    <div class="wrap">
      <div class="narrow">
        <h2 id="team-heading">Qui fait quoi</h2>
        <p>
          Une petite équipe, organisée comme un vrai studio indépendant. Les présentations individuelles
          arrivent avec la composition définitive du groupe.
        </p>
      </div>
      <div class="cards grid-districts">
        {
          roles.map((r) => (
            <article class="card">
              <span class="card-role">{r.role}</span>
              <h3>{r.who}</h3>
              <p>{r.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="values-heading">
    <div class="wrap split" style="align-items: start;">
      <div>
        <h2 id="values-heading">Ce à quoi nous tenons</h2>
        <p>
          Des jeux de gestion qui respectent le joueur : pas de monétisation agressive, des systèmes que l'on
          peut comprendre en les regardant, et des textes écrits et relus par des humains.
        </p>
        <a href="/jeux/veridia-2140/" class="btn btn-water">Voir Veridia 2140</a>
      </div>
      <div>
        <h2>Et l'IA, dans tout ça ?</h2>
        <p>
          Nous utilisons l'IA comme un outil : pour explorer des pistes visuelles, écrire du code plus vite et
          vérifier le référencement du site. Les choix, eux, restent les nôtres. Le journal détaillé de nos
          usages est public.
        </p>
        <a href={STUDIO.githubRepo} target="_blank" rel="noopener noreferrer">Lire le journal sur GitHub</a>
      </div>
    </div>
  </section>
</BaseLayout>
