---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FaqSection from "../../components/FaqSection.astro";
import ResponsivePicture from "../../components/ResponsivePicture.astro";
import MechanicDiagram from "../../components/MechanicDiagram.astro";
import { STUDIO } from "../../data/site";

const siteOrigin = Astro.site ? Astro.site.origin : "https://flexarion.alwaysdata.net";

const videoGameSchema = {
  "@context": "https://schema.org",
  "@type": "VideoGame",
  name: STUDIO.flagshipGame.title,
  description:
    "City-builder tactique et simulation éco-futuriste Solarpunk en Provence en 2140, conçu par Flexarion Studio à Aix-en-Provence.",
  genre: ["Strategy", "City-Builder", "Science Fiction", "Solarpunk"],
  gamePlatform: ["PC", "Windows", "Linux"],
  applicationCategory: "Game",
  operatingSystem: "Windows 11, Linux",
  inLanguage: "fr",
  author: {
    "@type": "Organization",
    name: STUDIO.legalName,
    url: siteOrigin,
  },
  publisher: {
    "@type": "Organization",
    name: STUDIO.legalName,
    url: siteOrigin,
  },
  image: `${siteOrigin}/images/veridia-hero.jpg`,
};

const gameFaqs = [
  {
    question: "Quel est le modèle économique imaginé pour Veridia 2140 ?",
    answer:
      "Dans le cadre de ce concept de studio, Veridia 2140 est pensé comme un jeu indépendant PC payant à achat unique (sans microtransaction ni boutique intégrée), accompagné d'une démo jouable.",
  },
  {
    question: "Veridia 2140 est-il déjà disponible à l'achat ?",
    answer:
      "Non : Veridia 2140 et Flexarion Studio constituent un projet universitaire de conception et de communication (BUT Informatique, IUT d'Aix-Marseille). Aucune vente ni précommande n'est ouverte.",
  },
  {
    question: "Qu'est-ce qui distingue Veridia 2140 des autres city-builders de science-fiction ?",
    answer:
      "Contrairement aux jeux spatiaux ou post-apocalyptiques sombres, Veridia 2140 adopte une direction Solarpunk méditerranéenne située à Aix-en-Provence en 2140, centrée sur la gravité hydraulique et le mycélium.",
  },
];
---

<BaseLayout
  title="Veridia 2140 : Jeu Solarpunk par Flexarion Studio à Aix"
  description="Découvrez Veridia 2140, le jeu phare de Flexarion Studio : city-builder Solarpunk en Provence, flux hydriques réalistes, réseau mycélien et modèle sans microtransaction."
  preloadHeroBase="/images/veridia-hero"
  ogImage="/images/veridia-hero.jpg"
  ogImageAlt="Veridia 2140 : dômes solaires au pied de la montagne Sainte-Victoire"
  breadcrumbs={[
    { name: "Accueil", href: "/" },
    { name: "Veridia 2140", href: "/jeux/veridia-2140/" },
  ]}
  schemas={[videoGameSchema]}
>
  <header class="wrap page-head split">
    <div>
      <h1>Veridia 2140 : faire passer l'été à une ville entière.</h1>
      <p class="lead">
        Un city-builder Solarpunk dans le Pays d'Aix en 2140. Vous héritez d'un district de Veridia, une
        cité de sept dômes reliés par des aqueducs, et vous devez lui faire traverser l'été le plus chaud
        jamais mesuré.
      </p>
      <dl class="facts">
        <div><dt>Genre</dt><dd>City-builder, stratégie</dd></div>
        <div><dt>Plateforme visée</dt><dd>PC (Windows, Linux)</dd></div>
        <div><dt>Modèle imaginé</dt><dd>Achat unique, sans microtransaction</dd></div>
        <div><dt>État</dt><dd>Concept en pré-production</dd></div>
      </dl>
    </div>
    <figure class="photo">
      <ResponsivePicture
        src="/images/veridia-hero.jpg"
        alt="Illustration principale de Veridia 2140 : dômes géodésiques, aqueduc et Sainte-Victoire"
        width={1280}
        height={720}
        eager={true}
      />
      <figcaption>Recherche visuelle : le bassin aixois au crépuscule, été 2140.</figcaption>
    </figure>
  </header>

  <section class="block block-chalk" aria-labelledby="mechanics-heading">
    <div class="wrap">
      <div class="narrow">
        <h2 id="mechanics-heading">Trois systèmes, un seul adversaire : la chaleur</h2>
        <p class="lead">
          Pas de combat dans Veridia 2140. Chaque été, la température monte et vos trois systèmes doivent
          tenir ensemble. Si l'un lâche, les deux autres suivent.
        </p>
      </div>
      <article class="mechanic">
        <div>
          <span class="tag">Hydrologie</span>
          <h3>L'eau ne remonte jamais</h3>
          <p>
            Les bassins et les aqueducs forment un réseau orienté : l'eau va du plus haut au plus bas. Le
            relief réel du Pays d'Aix décide donc où vous pouvez construire. Couvrir un canal d'une pergola
            solaire réduit l'évaporation, mais coûte cher.
          </p>
        </div>
        <MechanicDiagram type="water" label="Schéma : réseau d'eau gravitaire du réservoir jusqu'à la ville." />
      </article>
      <article class="mechanic">
        <div>
          <span class="tag">Mycélium</span>
          <h3>Un réseau vivant sous la ville</h3>
          <p>
            Le mycélium cultivé sous les restanques déplace l'humidité vers les îlots de chaleur. Il est
            efficace et gratuit, mais il meurt s'il reste sec trop longtemps. Sa lumière sur la carte vous
            dit où il souffre, sans aucune fenêtre d'alerte.
          </p>
        </div>
        <MechanicDiagram type="mycelium" label="Schéma : transfert d'humidité par le mycélium vers les rues chaudes." />
      </article>
      <article class="mechanic">
        <div>
          <span class="tag">Architecture</span>
          <h3>Calcaire et verre solaire</h3>
          <p>
            Le calcaire garde la fraîcheur de la nuit, le verre produit l'énergie du jour. L'orientation de
            chaque dôme est un arbitrage entre électricité et confort, à refaire quand l'été avance.
          </p>
        </div>
        <MechanicDiagram type="dome" label="Schéma : course du soleil au-dessus d'un dôme et orientation des panneaux." />
      </article>
    </div>
  </section>

  <section class="block" aria-labelledby="dev-heading">
    <div class="wrap split">
      <figure class="photo">
        <ResponsivePicture
          src="/images/devlog-hydrology.jpg"
          alt="Vue isométrique de canaux turquoise et de restanques cultivées sous un dôme dans Veridia 2140"
          width={1280}
          height={720}
          sizes="(max-width: 860px) 100vw, 540px"
        />
        <figcaption>Recherche visuelle : canaux et restanques sous un dôme.</figcaption>
      </figure>
      <div>
        <h2 id="dev-heading">Comment on le construit</h2>
        <p>
          La simulation repose sur des graphes orientés pour l'eau et une grille thermique pour la chaleur.
          Elle est déterministe : la même partie rejouée donne exactement le même résultat, ce qui nous permet
          de la tester automatiquement.
        </p>
        <p>
          Nous détaillons ces choix dans nos devlogs, et l'univers complet (chronologie, districts, factions)
          a sa propre page.
        </p>
        <div class="actions">
          <a href="/jouer/" class="btn btn-water">Jouer au prototype</a>
          <a href="/devlogs/simulation-flux-hydriques-graphes/" class="btn btn-ghost">Lire le devlog technique</a>
          <a href="/jeux/veridia-2140/univers/" class="btn btn-ghost">L'univers du jeu</a>
        </div>
        <p class="note" style="margin-top: 1.5rem;">
          {STUDIO.flagshipGame.status}. Aucune vente ni précommande n'est proposée.
        </p>
      </div>
    </div>
  </section>

  <FaqSection
    title="Questions sur Veridia 2140"
    items={gameFaqs}
    tone="chalk"
  />
</BaseLayout>
