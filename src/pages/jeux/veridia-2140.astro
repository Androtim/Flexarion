---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FaqSection from "../../components/FaqSection.astro";
import ResponsivePicture from "../../components/ResponsivePicture.astro";
import { STUDIO } from "../../data/site";

const siteOrigin = Astro.site ? Astro.site.origin : "https://flexarion.alwaysdata.net";

const videoGameSchema = {
  "@context": "https://schema.org",
  "@type": "VideoGame",
  name: STUDIO.flagshipGame.title,
  description:
    "City-builder tactique et simulation éco-futuriste Solarpunk en Provence en 2140, conçu par Flexarion Studio à Aix-en-Provence.",
  genre: ["Strategy", "City-Builder", "Science Fiction", "Solarpunk"],
  gamePlatform: ["PC", "Windows", "Linux"],
  applicationCategory: "Game",
  operatingSystem: "Windows 11, Linux",
  inLanguage: "fr",
  author: {
    "@type": "Organization",
    name: STUDIO.legalName,
    url: siteOrigin,
  },
  publisher: {
    "@type": "Organization",
    name: STUDIO.legalName,
    url: siteOrigin,
  },
  image: `${siteOrigin}/images/veridia-hero.jpg`,
};

const gameFaqs = [
  {
    question: "Quel est le modèle économique imaginé pour Veridia 2140 ?",
    answer:
      "Dans le cadre de ce concept de studio, Veridia 2140 est pensé comme un jeu indépendant PC payant à achat unique (sans microtransaction ni boutique intégrée), accompagné d'une démo jouable.",
  },
  {
    question: "Veridia 2140 est-il déjà disponible à l'achat ?",
    answer:
      "Non : Veridia 2140 et Flexarion Studio constituent un projet universitaire de conception et de communication (BUT Informatique, IUT d'Aix-Marseille). Aucune vente ni précommande n'est ouverte.",
  },
  {
    question: "Qu'est-ce qui distingue Veridia 2140 des autres city-builders de science-fiction ?",
    answer:
      "Contrairement aux jeux spatiaux ou post-apocalyptiques sombres, Veridia 2140 adopte une direction Solarpunk méditerranéenne située à Aix-en-Provence en 2140, centrée sur la gravité hydraulique et le mycélium.",
  },
];
---

<BaseLayout
  title="Veridia 2140 : Jeu Solarpunk par Flexarion Studio à Aix"
  description="Découvrez Veridia 2140, le jeu phare de Flexarion Studio : city-builder Solarpunk en Provence, flux hydriques réalistes, réseau mycélien et modèle sans microtransaction."
  preloadHeroBase="/images/veridia-hero"
  breadcrumbs={[
    { name: "Accueil", href: "/" },
    { name: "Veridia 2140", href: "/jeux/veridia-2140/" },
  ]}
  schemas={[videoGameSchema]}
>
  <section class="section">
    <div class="container hero-editorial">
      <div>
        <span class="kicker">Silo 02 / Dossier Jeu Phare</span>
        <h1>Veridia 2140 : bâtir les oasis solaires de Provence.</h1>
        <p class="lead">
          En 2140, le bassin aixois affronte des étés extrêmes. Aux commandes de dômes autonomes autour
          d'<strong>Aix-en-Provence</strong>, tracez des aqueducs en calcaire, ombragez les cultures en
          restanques et refroidissez la ville par un réseau mycélien vivant.
        </p>

        <div class="specs-strip" aria-label="Fiche technique de Veridia 2140">
          <div class="spec-cell">
            <span class="spec-label">Genre</span>
            <span class="spec-value">City-Builder Tactique</span>
          </div>
          <div class="spec-cell">
            <span class="spec-label">Modèle envisagé</span>
            <span class="spec-value">Indé payant (0 pub)</span>
          </div>
          <div class="spec-cell">
            <span class="spec-label">Statut du projet</span>
            <span class="spec-value">Concept académique (AMU)</span>
          </div>
        </div>

        <p style="margin-top: 1.25rem; font-size: 0.9rem; color: var(--ink-faint);">
          <strong>Note de transparence :</strong> {STUDIO.flagshipGame.status}. Aucune vente ni précommande
          réelle n'est proposée sur ce site.
        </p>
      </div>

      <figure class="plate-frame">
        <ResponsivePicture
          src="/images/veridia-hero.jpg"
          alt="Illustration principale de Veridia 2140 avec ses dômes géodésiques en Provence"
          width={1280}
          height={720}
          eager={true}
        />
        <figcaption class="plate-caption">
          <span>Secteur Sainte-Victoire · Dôme calcaire &amp; aqueducs</span>
          <span>Pré-production</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section-tight section-ruled" aria-labelledby="mechanics-heading">
    <div class="container">
      <span class="kicker kicker-pine">02 / Mécaniques de jeu</span>
      <h2 id="mechanics-heading">Trois systèmes physiques imbriqués</h2>
      <div class="archival-list">
        <article class="archival-row">
          <span class="archival-num">01</span>
          <h3>Hydrologie gravitaire</h3>
          <p>
            Chaque bassin et aqueduc forme un graphe orienté : le relief provençal dicte la pression de
            l'eau, tandis que les pergolas solaires freinent l'évaporation pendant les canicules.
          </p>
          <span style="font-family: var(--font-mono); font-size: 0.78rem; color: var(--pine);">Graphes</span>
        </article>

        <article class="archival-row">
          <span class="archival-num">02</span>
          <h3>Symbiose mycélienne</h3>
          <p>
            Sous les terrasses d'oliviers et de lavande, un réseau de mycélium bioluminescent transfère
            l'humidité des bassins frais vers les îlots de chaleur urbains.
          </p>
          <span style="font-family: var(--font-mono); font-size: 0.78rem; color: var(--pine);">Thermique</span>
        </article>

        <article class="archival-row">
          <span class="archival-num">03</span>
          <h3>Calcaire &amp; verre solaire</h3>
          <p>
            L'orientation de chaque verrière géodésique arbitre entre captation photovoltaïque matinale et
            inertie thermique nocturne du bâti provençal.
          </p>
          <span style="font-family: var(--font-mono); font-size: 0.78rem; color: var(--pine);">Urbanisme</span>
        </article>
      </div>
    </div>
  </section>

  <section class="section-tight section-ruled" aria-labelledby="gallery-heading">
    <div class="container">
      <span class="kicker">03 / Étude visuelle &amp; architecture</span>
      <h2 id="gallery-heading">Aperçu du moteur et carnet d'ingénierie</h2>
      <div class="grid-2" style="margin-top: 1.5rem;">
        <figure class="plate-frame">
          <ResponsivePicture
            src="/images/devlog-hydrology.jpg"
            alt="Vue isométrique des canaux d'eau turquoise et des capteurs solaires dans Veridia 2140"
            width={1280}
            height={720}
            sizes="(max-width: 760px) 100vw, 560px"
            eager={false}
          />
          <figcaption class="plate-caption">
            <span>Planche 02 · Canaux turquoise et nœuds mycéliens sous dôme</span>
            <span>Isométrie</span>
          </figcaption>
        </figure>

        <div class="panel" style="display: flex; flex-direction: column; justify-content: center;">
          <span class="kicker kicker-pine">Côté ingénierie</span>
          <h3>Comment est modélisée la simulation ?</h3>
          <p>
            Nous détaillons notre modèle de simulation (graphes orientés de flux, automates cellulaires
            thermiques et architecture déterministe ciblant 60 FPS) dans nos carnets ouverts.
          </p>
          <div class="actions">
            <a href="/devlogs/simulation-flux-hydriques-graphes/" class="btn btn-primary">
              Lire le Carnet Technique #2
            </a>
            <a href="/contact/" class="link-editorial">Dossier Presse</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <FaqSection
    title="FAQ sur Veridia 2140"
    subtitle="Les informations vérifiables sur le gameplay, les plateformes et le cadre du projet."
    items={gameFaqs}
  />
</BaseLayout>
